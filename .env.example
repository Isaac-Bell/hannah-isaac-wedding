# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://wedding:wedding_dev_password@localhost:5433/wedding

# Invitation security (generate with: openssl rand -base64 48)
INVITATION_CODE_PEPPER=replace-with-at-least-32-random-characters
# Enable only when direct origin access is blocked and the reverse proxy owns these headers.
TRUST_PROXY_HEADERS=false

# Future admin authentication
ADMIN_AUTH_SECRET=replace-with-a-long-random-secret

# Optional travel configuration
TRAVEL_AIRPORT_INFO_URL=

# Optional external personal-payment details (server-only; examples are not real)
GIFT_ZELLE_RECIPIENT_NAME=
GIFT_ZELLE_EMAIL=
GIFT_ZELLE_PHONE=
GIFT_PAYPAL_ME_URL=
